# Minimal Peak V1 API
# Preferred for production deployments such as Railway.
# When DATABASE_URL is set, the app uses PostgreSQL instead of SQLite.
DATABASE_URL=postgresql://postgres:password@localhost:5432/peak

# Optional: override the default SQLite database location for local development.
PEAK_DB_PATH=peak.db

# Optional: used by managed platforms such as Railway.
PORT=8000

# Strava OAuth configuration for future connect/sync endpoints.
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://127.0.0.1:8000/strava/connect/callback
